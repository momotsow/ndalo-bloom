{
  "name": "ndalo-bloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify": "tsx scripts/verify-schema.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --dir tests/components",
    "test:arch": "vitest run --dir tests/architecture",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "audit:ci": "audit-ci --config ./audit-ci.jsonc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@prisma/client": "6.2.1",
    "@sentry/nextjs": "8.55.2",
    "@vercel/speed-insights": "1.2.0",
    "posthog-node": "4.3.2",
    "zod": "3.24.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-toast": "1.2.4"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.23",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "@eslint/js": "9.18.0",
    "typescript-eslint": "8.20.0",
    "eslint-plugin-boundaries": "5.0.1",
    "prettier": "3.4.2",
    "vitest": "2.1.8",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@testing-library/jest-dom": "6.6.3",
    "jest-axe": "9.0.0",
    "@types/jest-axe": "3.5.9",
    "audit-ci": "7.1.0",
    "@playwright/test": "1.51.1",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.21",
    "storybook": "8.4.7",
    "@storybook/nextjs": "8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-a11y": "8.4.7",
    "@storybook/blocks": "8.4.7",
    "@storybook/test": "8.4.7"
  },
  "overrides": {
    "vite": "5.4.21",
    "postcss": "8.5.23"
  }
}
