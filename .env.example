# Ndalo Bloom — Environment Variables (EXAMPLE)
#
# Copy to `.env.local` for local development and fill in real values there.
# NEVER commit real secrets. `.env*` files are gitignored.
#
# Configuration is categorized (see src/config) and validated lazily/feature-scoped:
#   - public      : NEXT_PUBLIC_* (safe for the browser bundle)
#   - server      : server-only secrets (never sent to the client)
#   - integration : per-provider secrets (validated on first use of that provider)
#   - build       : only variables genuinely needed during the build

# ---------------------------------------------------------------------------
# PUBLIC / BROWSER (safe to expose)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SERVER-ONLY (secrets — never exposed to the client)
# ---------------------------------------------------------------------------
# Neon PostgreSQL connection string (development). PLACEHOLDER ONLY — put the real
# value in .env.local (git-ignored). In CI it is supplied via the DATABASE_URL secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Better Auth (used only within the auth layer, behind AuthService).
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Sentry server DSN (optional; server error reporting is disabled if unset).
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# INTEGRATION (per-provider — adapters implemented in later Specs)
# ---------------------------------------------------------------------------
# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""

# OpenAI (AI provider)
OPENAI_API_KEY=""

# PostHog (product analytics)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# ---------------------------------------------------------------------------
# BUILD-TIME
# ---------------------------------------------------------------------------
# NODE_ENV is managed by tooling; override only if you know you need to.
# NODE_ENV="development"
